# Backend loads these from the process environment or backend/.env.
# The repo-root .env (gitignored) already holds the real GROQ_API_KEY; copy it
# here or export it before running uvicorn.
GROQ_API_KEY=gsk_...
MONGODB_URI=mongodb+srv://...
MONGODB_DB_NAME=ria_v2
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
